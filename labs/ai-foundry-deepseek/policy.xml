<policies>
    <inbound>
        <base />
        <set-backend-service backend-id="{backend-id}" />
        <llm-token-limit counter-key="@(context.Subscription.Id)" tokens-per-minute="200" estimate-prompt-tokens="true" retry-after-header-name="x-apim-retry-after" remaining-tokens-header-name="x-apim-remaining-tokens" remaining-tokens-variable-name="remainingTokens" tokens-consumed-header-name="x-apim-tokens-consumed" />
        <llm-emit-token-metric namespace="llm">
            <dimension name="Client IP" value="@(context.Request.IpAddress)" />
            <dimension name="API ID" value="@(context.Api.Id)" />
        </llm-emit-token-metric>
    </inbound>
    <backend>
        <base />
    </backend>
    <outbound>
        <base />
    </outbound>
    <on-error>
        <base />
    </on-error>
</policies>
